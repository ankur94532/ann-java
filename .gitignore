# Datasets are large (SIFT1M is ~500MB unpacked, GIST1M ~3.6GB). Never commit them.
data/

# Build output
build/
out/
.gradle/
*.class
*.jar

# ...except the Gradle wrapper jar, which must be committed or ./gradlew cannot
# bootstrap for anyone who clones the repo.
!gradle/wrapper/gradle-wrapper.jar

# JFR recordings and JMH raw output
*.jfr
build/jmh/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editors / OS
.idea/
*.iml
.vscode/
.DS_Store

# Local virtualenv created by scripts/setup_python.sh
.venv/
